# Absolute origin used for social-share metadata (OpenGraph / Twitter cards) so
# shared links preview correctly. On Netlify this is set in netlify.toml; set it
# here (or in .env.local) only to override for local development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Use a long random value in deployed environments so compact interview
# assignment links cannot be modified and re-signed by recipients.
INTERVIEW_LINK_SECRET=replace-with-a-long-random-secret

# Microsoft Clarity project id (session replay + heatmaps). A default id is baked
# into shared/components/Clarity.tsx and runs in production automatically, so this
# is only needed to OVERRIDE it (e.g. a different Clarity project). Public, not a
# secret. Tracking is disabled outside production regardless of this value.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Codebase assessments (docs/CODEBASE_ASSESSMENTS.md). Always on in `next dev`; on
# production builds they stay hidden (pages 404, nav link absent) until this is
# "true". Do not enable on the live site until a real database backs the store.
NEXT_PUBLIC_CODEBASE_ASSESSMENTS=
# file | memory. Required in production if the flag above is on; both are
# ephemeral on serverless hosts, so this is for previews and local testing only.
ASSESSMENT_STORE=
