{
  "rules": [
    {
      "id": "deliver-at-dock",
      "when": "deliveryHere && carryingPackage",
      "do": "deliver",
      "priority": 200,
      "description": "Highest priority: unload cargo at its matching shipping dock."
    },
    {
      "id": "pick-at-face",
      "when": "packageHere && capacityRemaining > 0",
      "do": "pick-up",
      "priority": 190,
      "description": "Load a package whenever the robot reaches a pick face with free cargo space."
    },
    {
      "id": "recharge-when-low",
      "when": "chargingHere && energy < 40",
      "do": "charge",
      "priority": 180,
      "description": "Top up at a charging bay when the battery runs low."
    },
    {
      "id": "advance-aisle",
      "when": "!wallAhead",
      "do": "step",
      "priority": 60,
      "description": "Drive straight down a clear aisle."
    },
    {
      "id": "follow-left",
      "when": "!wallLeft",
      "do": "pivot-left",
      "priority": 50,
      "description": "Blocked ahead — turn into the open aisle on the left (left-hand rule)."
    },
    {
      "id": "turn-right",
      "when": "!wallRight",
      "do": "pivot-right",
      "priority": 40,
      "description": "Blocked ahead and left — take the aisle on the right."
    },
    {
      "id": "about-face",
      "when": "always",
      "do": "pivot-right",
      "priority": 10,
      "description": "Dead end — turn around and retrace the aisle."
    }
  ]
}
